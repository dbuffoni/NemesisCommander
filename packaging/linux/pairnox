#!/bin/sh
# Starts Pairnox from the AppImage:
#
#   Pairnox.AppImage [LEFT] [RIGHT]   the window (pnxr-gui)
#   Pairnox.AppImage pnxr [ARGS...]    the `pnxr` program: the terminal
#                                              interface and the commands
#
# A link named `pnxr` to the AppImage starts `pnxr` directly.
here=$(dirname "$(readlink -f "$0")")
case "$(basename "${ARGV0:-$0}")" in
    pnxr) exec "$here/pnxr" "$@" ;;
esac
if [ "${1:-}" = pnxr ]; then
    shift
    exec "$here/pnxr" "$@"
fi
# GNOME: Qt only dresses the title bar in the dark theme; with the desktop
# portal as its platform theme the window follows the light/dark setting.
# A theme the user chose (QT_QPA_PLATFORMTHEME) is left alone.
case "${XDG_CURRENT_DESKTOP:-}" in
    *GNOME*) : "${QT_QPA_PLATFORMTHEME:=xdgdesktopportal}"; export QT_QPA_PLATFORMTHEME ;;
esac
exec "$here/pnxr-gui" "$@"
