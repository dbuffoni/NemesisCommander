#!/bin/sh
# Starts SuperCommander from the AppImage:
#
#   SuperCommander.AppImage [LEFT] [RIGHT]   the window (sc-gui)
#   SuperCommander.AppImage sc [ARGS...]     the `sc` program: the terminal
#                                            interface and the commands
#
# A link named `sc` to the AppImage starts `sc` directly.
here=$(dirname "$(readlink -f "$0")")
case "$(basename "${ARGV0:-$0}")" in
    sc) exec "$here/sc" "$@" ;;
esac
if [ "${1:-}" = sc ]; then
    shift
    exec "$here/sc" "$@"
fi
exec "$here/sc-gui" "$@"
