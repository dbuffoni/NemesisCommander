#!/bin/sh
# Starts NemesisCommander from the AppImage:
#
#   NemesisCommander.AppImage [LEFT] [RIGHT]   the window (nmc-gui)
#   NemesisCommander.AppImage nmc [ARGS...]    the `nmc` program: the terminal
#                                              interface and the commands
#
# A link named `nmc` to the AppImage starts `nmc` directly.
here=$(dirname "$(readlink -f "$0")")
case "$(basename "${ARGV0:-$0}")" in
    nmc) exec "$here/nmc" "$@" ;;
esac
if [ "${1:-}" = nmc ]; then
    shift
    exec "$here/nmc" "$@"
fi
exec "$here/nmc-gui" "$@"
